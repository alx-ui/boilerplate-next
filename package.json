{
  "name": "boilerplate-next",
  "description": "A TypeScript starter for Next.js that includes all you need to build amazing projects",
  "version": "2.1.0",
  "private": true,
  "keywords": [
    "nextjs",
    "boilerplate",
    "typescript",
    "tailwindcss",
    "eslint",
    "prettier"
  ],
  "engines": {
    "node": "^22.22.1 || >=24.10.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate": "yarn type-check && yarn lint && yarn format:check",
    "commit": "cz",
    "release": "semantic-release",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs}": [
      "eslint --no-warn-ignored --fix",
      "prettier --write"
    ],
    "*.{json,css,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@ialexanderbrito/eslint-config": "3.0.0",
    "@semantic-release/changelog": "6.0.3",
    "@semantic-release/git": "10.0.1",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "24.19.4",
    "@types/react": "19.3.3",
    "@types/react-dom": "19.3.0",
    "commitizen": "4.3.2",
    "cz-conventional-changelog": "3.3.0",
    "eslint": "10.15.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.2",
    "postcss": "8.5.33",
    "prettier": "3.10.1",
    "semantic-release": "25.0.9",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  }
}
